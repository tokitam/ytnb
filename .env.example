# YouTube Data API v3 の API キー(公開コメント取得のみなら API キーで足りる)
YOUTUBE_API_KEY=
# サービスアカウントの JSON キーのパス(Sheets / Drive 用)
GOOGLE_SA_JSON=./service_account.json
# Drive に Doc を作るための OAuth クライアント (デスクトップ アプリ) の JSON
# ※ サービスアカウントは Drive の容量を持たないため、個人アカウントでは OAuth が必要
GOOGLE_OAUTH_CLIENT_JSON=./oauth_client.json
# OAuth ログイン後に自動生成されるトークンの保存先
GOOGLE_OAUTH_TOKEN=./token.json
